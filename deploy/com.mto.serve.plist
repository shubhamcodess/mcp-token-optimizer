<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd agent: keeps `mto serve` (the local HTTP proxy) running and restarts it if it dies.
  1. Replace __NODE__ with the output of `which node` and __MTO_DIR__ with the absolute path of this repo.
  2. cp deploy/com.mto.serve.plist ~/Library/LaunchAgents/
  3. launchctl load ~/Library/LaunchAgents/com.mto.serve.plist
  Stop/unload: launchctl unload ~/Library/LaunchAgents/com.mto.serve.plist    Logs: /tmp/mto-serve.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mto.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__MTO_DIR__/dist/cli.js</string>
    <string>serve</string>
    <string>--port</string>
    <string>8787</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/mto-serve.log</string>
  <key>StandardErrorPath</key><string>/tmp/mto-serve.log</string>
</dict>
</plist>
